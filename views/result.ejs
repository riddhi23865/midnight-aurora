
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Registration Successful | Aurora</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="background-glow glow-one"></div>
    <div class="background-glow glow-two"></div>

    <main class="main-container">

        <section class="registration-card">

            <!-- LEFT SECTION -->

            <div class="welcome-section success-left">

                <div class="brand">
                    <span class="brand-icon">✦</span>
                    AURORA
                </div>

                <div class="welcome-content">

                    <div class="success-icon">✓</div>

                    <h1>
                        You're Part<br>
                        of Our Story!
                    </h1>

                    <p>
                        Congratulations!
                        Your registration has been
                        completed successfully.
                    </p>

                    <div class="welcome-tag">
                        ✨ WELCOME TO AURORA
                    </div>

                </div>

                <div class="left-footer">
                    Your next chapter begins now.
                </div>

            </div>


            <!-- RIGHT SECTION -->

            <div class="form-section">

                <div class="form-top">
                    <span>REGISTRATION STATUS</span>
                    <span class="status-dot">● SUCCESS</span>
                </div>

                <div class="success-content">

                    <div class="success-small-icon">
                        ✓
                    </div>

                    <span class="small-heading">
                        ACCOUNT CREATED
                    </span>

                    <h2>You're Registered!</h2>

                    <p>
                        Your information has been submitted successfully.
                    </p>


                    <!-- USER DETAILS -->

                    <div class="user-details">

                        <div class="detail-row">

                            <span>FULL NAME</span>

                            <strong>
                                <%= name %>
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span>EMAIL ADDRESS</span>

                            <strong>
                                <%= email %>
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span>STATUS</span>

                            <strong class="verified">
                                ✓ Registration Successful
                            </strong>

                        </div>

                    </div>


                    <!-- BACK BUTTON -->

                    <a href="/" class="submit-btn another-btn">

                        Register Another User

                        <span>→</span>

                    </a>


                    <div class="form-bottom">
                        <span>✦</span>
                        Thank you for joining us.
                    </div>

                </div>

            </div>

        </section>


        <footer class="page-footer">
            © 2026 AURORA. ALL RIGHTS RESERVED.
        </footer>

    </main>

</body>
</html>
