
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Midnight Aurora | Join Us</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="background-glow glow-one"></div>
    <div class="background-glow glow-two"></div>

    <main class="main-container">

        <section class="registration-card">

            <!-- LEFT SECTION -->

            <div class="welcome-section">

                <div class="brand">
                    <span class="brand-icon">✦</span>
                    AURORA
                </div>

                <div class="welcome-content">

                    <div class="moon-icon">☾</div>

                    <h1>
                        Welcome to<br>
                        Something New.
                    </h1>

                    <p>
                        Your journey starts here.
                        Create your account and become
                        part of our community.
                    </p>

                    <div class="welcome-tag">
                        ✨ YOUR FUTURE STARTS TODAY
                    </div>

                </div>

                <div class="left-footer">
                    Designed for your next chapter.
                </div>

            </div>


            <!-- RIGHT SECTION -->

            <div class="form-section">

                <div class="form-top">
                    <span>New to Aurora?</span>
                    <a href="/">Join Us</a>
                </div>

                <div class="form-content">

                    <div class="form-heading">

                        <span class="small-heading">
                            GET STARTED
                        </span>

                        <h2>Create Account</h2>

                        <p>
                            Enter your details to join our community.
                        </p>

                    </div>


                    <% if (typeof error !== 'undefined' && error) { %>

                        <div class="error-message">
                            <%= error %>
                        </div>

                    <% } %>


                    <form action="/register" method="POST">

                        <!-- NAME -->

                        <div class="input-group">

                            <label for="name">
                                FULL NAME
                            </label>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Enter your full name"
                                value="<%= typeof name !== 'undefined' ? name : '' %>"
                                maxlength="80"
                                autocomplete="name"
                                required
                            >

                        </div>


                        <!-- EMAIL -->

                        <div class="input-group">

                            <label for="email">
                                EMAIL ADDRESS
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Enter your email address"
                                value="<%= typeof email !== 'undefined' ? email : '' %>"
                                maxlength="254"
                                autocomplete="email"
                                required
                            >

                        </div>


                        <!-- TERMS -->

                        <div class="terms">

                            <input
                                type="checkbox"
                                id="terms"
                                name="terms"
                                value="accepted"
                                required
                            >

                            <label for="terms">
                                I agree to the
                                <a href="#terms">
                                    Terms & Conditions
                                </a>
                            </label>

                        </div>


                        <!-- BUTTON -->

                        <button type="submit" class="submit-btn">

                            Create My Account

                            <span>→</span>

                        </button>

                    </form>


                    <div class="form-bottom">
                        <span>✦</span>
                        Simple. Secure. Beautiful.
                    </div>

                </div>

            </div>

        </section>


        <footer class="page-footer">
            © 2026 AURORA. ALL RIGHTS RESERVED.
        </footer>

    </main>

</body>
</html>
